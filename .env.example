# Copy to .env (or set in your host's dashboard). Only JWT_SECRET is required in production.

# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

NODE_ENV=production
PORT=4000

# SQLite file location. Point this at a persistent disk/volume in production.
DATABASE_PATH=/data/shop.db

# Seed demo@shopsphere.dev / demo1234 on first start (default: true in dev, false in production).
SEED_DEMO_USER=false

# Session cookies are Secure (HTTPS-only) in production. Set false only to test a production build over plain http.
# COOKIE_SECURE=false
