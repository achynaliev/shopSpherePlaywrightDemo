{
  "name": "shopsphere-e2e",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Playwright end-to-end tests for ShopSphere.",
  "scripts": {
    "test": "playwright test",
    "test:azure": "playwright test --config=playwright.service.config.js",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "install-browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@azure/identity": "^4.14.1",
    "@azure/playwright": "^1.1.6",
    "@playwright/test": "^1.64.1"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "path": "^0.12.7"
  }
}
